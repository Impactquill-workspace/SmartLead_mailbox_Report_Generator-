# ==============================================================================
# SMARTLEAD WEEKLY MAILBOX ANALYTICS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
# ==============================================================================

# Required: Your Smartlead API Key (Settings -> Activate API in Smartlead dashboard)
SMARTLEAD_API_KEY=your_api_key_here

# Database URL for PostgreSQL (OPTIONAL)
# If omitted or commented out, the application runs in Standalone mode (Excel + Web UI) with zero setup.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartlead_reports


# Smartlead API Base URL (default is official v1 endpoint)
API_BASE_URL=https://server.smartlead.ai/api/v1

# Concurrency & Rate Limiting (Smartlead has strict limits: 10 req / 2s)
# Keep concurrency low (2-3) and interval >= 0.35s to prevent 429 rate limit errors
SMARTLEAD_MAX_CONCURRENCY=2
SMARTLEAD_REQUEST_INTERVAL=0.35
SMARTLEAD_REQUEST_TIMEOUT=30
SMARTLEAD_MAX_RETRIES=5
SMARTLEAD_MAX_RETRY_DELAY=65.0

# Campaign Filtering
# Set to true only if you need historical analytics on ARCHIVED/DRAFTED campaigns
SMARTLEAD_INCLUDE_ARCHIVED=false
SMARTLEAD_INCLUDE_DRAFTED=false

# Scheduled Report Settings (UTC)
REPORT_DAY=MONDAY
REPORT_HOUR=9
REPORT_MINUTE=0

# Feature Flags
DRY_RUN=false
LOG_LEVEL=INFO
